<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.RiwayatController" stylesheets="@css/style.css">
<padding>
<Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
</padding>
<children>
<Label text="Riwayat Transaksi" styleClass="page-title"/>
<TableView fx:id="transaksiTable" VBox.vgrow="ALWAYS">
<columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
<placeholder><Label text="Belum ada transaksi"/></placeholder>
<columns>
<TableColumn text="BILL#" prefWidth="130">
<cellValueFactory><PropertyValueFactory property="billNumber"/></cellValueFactory>
</TableColumn>
<TableColumn text="Tanggal" prefWidth="150">
<cellValueFactory><PropertyValueFactory property="tanggal"/></cellValueFactory>
</TableColumn>
<TableColumn text="Obat Dibeli (Kode)" prefWidth="260">
<cellValueFactory><PropertyValueFactory property="daftarObat"/></cellValueFactory>
</TableColumn>
<TableColumn text="Jumlah Obat" prefWidth="90">
<cellValueFactory><PropertyValueFactory property="jumlahObat"/></cellValueFactory>
</TableColumn>
<TableColumn text="Total" prefWidth="110">
<cellValueFactory><PropertyValueFactory property="totalText"/></cellValueFactory>
</TableColumn>
<TableColumn text="Metode Bayar" prefWidth="100">
<cellValueFactory><PropertyValueFactory property="metodeBayar"/></cellValueFactory>
</TableColumn>
</columns>
</TableView>
<HBox spacing="10.0" alignment="CENTER_LEFT">
<children>
<Button styleClass="custom-button" onAction="#handleLihatStruk" text="Lihat Struk"/>
<Button styleClass="button-secondary" onAction="#refresh" text="Refresh"/>
<Pane HBox.hgrow="ALWAYS"/>
<Label fx:id="ringkasanLabel" styleClass="total-label"/>
</children>
</HBox>
</children>
</VBox>
